# ==============================================================================
# STARTUP × INVESTOR PORTAL - CONFIGURATION TEMPLATE (.env.example)
# ==============================================================================
# Copy this file to .env and configure for your local or live hosting environment.
# 
# [1] LOCALHOST XAMPP (Local Development):
#     DB_HOST=127.0.0.1
#     DB_PORT=3306 (or 3307)
#     DB_NAME=startup_portal
#     DB_USER=root
#     DB_PASS=
#
# [2] LIVE HOSTING / CPANEL (Production Deployment):
#     DB_HOST=localhost
#     DB_PORT=3306
#     DB_NAME=cpaneluser_startupportal   (Database name created in cPanel)
#     DB_USER=cpaneluser_dbuser         (Database username created in cPanel)
#     DB_PASS=YourLiveDatabasePassword  (Database password created in cPanel)
#     APP_URL=https://yourdomain.com    (Auto-detected! Leave empty or set to domain)
# ==============================================================================

# Database Connection
DB_HOST=localhost
DB_PORT=3306
DB_NAME=startup_portal
DB_USER=root
DB_PASS=

# Optional Unix Socket (for Linux shared hosting if needed)
DB_SOCKET=

# Application Settings
APP_NAME="STARTUP × INVESTOR"
APP_ENV=production
APP_KEY=sec_key_startup_hub_9876543210_portal

# Base URL (Auto-detected on live server)
APP_URL=

# Mail & SMTP Configuration
MAIL_MAILER=mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=notifications@startupportal.com
MAIL_FROM_NAME="STARTUP × INVESTOR"
