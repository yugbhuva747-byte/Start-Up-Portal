<IfModule mod_rewrite.c>
    RewriteEngine On

    # Prevent directory indexing
    Options -Indexes +FollowSymLinks

    # Block direct web access to sensitive config, git and database files
    <FilesMatch "(^\.env|\.sql$|\.git)">
        Order allow,deny
        Deny from all
    </FilesMatch>

    # 1. External Redirect: remove trailing slash for non-directories
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+)/+(\?[^\s]*)?\sHTTP [NC]
    RewriteRule ^ %1%2 [R=302,NE,L]

    # 2. External Redirect: remove index.php
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+/)index\.php(\?[^\s]*)?\sHTTP [NC]
    RewriteRule ^ %1%2 [R=302,NE,L]

    # 3. External Redirect: remove .php extension if requested directly in the browser
    # Preserves query parameters and avoids double encoding with [NE]
    RewriteCond %{REQUEST_METHOD} ^(GET|HEAD)$ [NC]
    RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s([^?]+)\.php(\?[^\s]*)?\sHTTP [NC]
    RewriteRule ^ %1%2 [R=302,NE,L]

    # 4. Internal Rewrite: serve .php file silently for clean extensionless URLs
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME}.php -f
    RewriteRule ^(.*)$ $1.php [L,QSA]
</IfModule>
